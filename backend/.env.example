# Database (inside Docker: host = "db", port = 5432)
DATABASE_URL=postgresql+asyncpg://argajit:changeme@db:5432/argajit
DB_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend / CORS
FRONTEND_URL=https://argajitsrkar.in
CORS_ORIGINS=https://argajitsrkar.in,http://localhost:3002

# Admin allowlist (comma-separated)
ADMIN_EMAILS=argajit05@gmail.com

# NextAuth shared secret (must match frontend NEXTAUTH_SECRET exactly)
NEXTAUTH_SECRET=replace-with-32-char-random

# Google OAuth (same client used by frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible) - leave blank in dev, uploads fall back to local /app/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=argajit-resources
R2_PUBLIC_BASE=

# Buttondown (shared with GrantSetu); blank -> log to stdout
BUTTONDOWN_API_KEY=
